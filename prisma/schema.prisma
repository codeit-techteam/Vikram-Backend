  updatedBy               String?  @map("updated_by") @db.Uuid
  updatedByName           String?  @map("updated_by_name") @db.VarChar(120)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("delivery_benefit_configs")
}

/// Pricing-vehicle capacity master (BIKE / E_LOADER / …). Capacities are Admin-configurable — never invent kg/CFT.
model DeliveryVehicleConfig {
  id                        String              @id @default(uuid()) @db.Uuid
  vehicleType               DeliveryVehicleType @unique @map("vehicle_type")
  displayName               String              @map("display_name") @db.VarChar(80)
  /// null until Admin configures — do not invent operational capacities
  maxWeightKg               Decimal?            @map("max_weight_kg") @db.Decimal(12, 3)
  maxVolumeCft              Decimal?            @map("max_volume_cft") @db.Decimal(12, 3)
  maxQuantity               Decimal?            @map("max_quantity") @db.Decimal(12, 3)
  /// Safe utilization % (default 100). Usable = max * (limit/100).
  capacityUtilizationLimit  Decimal             @default(100) @map("capacity_utilization_limit") @db.Decimal(5, 2)
  /// Lower number = preferred first (smallest suitable vehicle)
  priority                  Int                 @default(100)
  active                    Boolean             @default(true)
  /// JSON array of category IDs/slugs; null = all categories allowed
  allowedProductCategories  Json?               @map("allowed_product_categories") @db.JsonB
  createdBy                 String?             @map("created_by") @db.Uuid
  updatedBy                 String?             @map("updated_by") @db.Uuid
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  @@index([active, priority])
  @@map("delivery_vehicle_configs")
}

/// Engine behaviour toggles (multi-vehicle, bulk quote, qty-tier fallback).
model DeliveryEngineConfig {
  id                      String   @id @default(uuid()) @db.Uuid
  configKey               String   @unique @default("DEFAULT") @map("config_key") @db.VarChar(40)
  /// AUTO_SPLIT | BULK_QUOTE | REJECT
  multiVehicleMode        String   @default("BULK_QUOTE") @map("multi_vehicle_mode") @db.VarChar(30)
  enablePartialDelivery   Boolean  @default(false) @map("enable_partial_delivery")
  /// When true and vehicle capacities are unset, fall back to bag-qty tiers (migration path)
  qtyTierFallbackEnabled  Boolean  @default(true) @map("qty_tier_fallback_enabled")
  bulkOrderThresholdKg    Decimal? @map("bulk_order_threshold_kg") @db.Decimal(12, 3)
  bulkOrderThresholdCft   Decimal? @map("bulk_order_threshold_cft") @db.Decimal(12, 3)
  bulkOrderThresholdQty   Int?     @map("bulk_order_threshold_qty")
  updatedBy               String?  @map("updated_by") @db.Uuid
  updatedByName           String?  @map("updated_by_name") @db.VarChar(120)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("delivery_engine_configs")
}
