  enquiryNumber            String                   @unique @map("enquiry_number") @db.VarChar(40)
  customerId               String                   @map("customer_id") @db.Uuid
  /// Snapshot fields preserved at submission time
  customerNameSnapshot     String?                  @map("customer_name_snapshot") @db.VarChar(200)
  customerPhoneSnapshot    String?                  @map("customer_phone_snapshot") @db.VarChar(20)
  customerEmailSnapshot    String?                  @map("customer_email_snapshot") @db.VarChar(200)
  customerTypeSnapshot     String?                  @map("customer_type_snapshot") @db.VarChar(50)
  gstNumberSnapshot        String?                  @map("gst_number_snapshot") @db.VarChar(20)
  companyName              String                   @map("company_name") @db.VarChar(200)
  projectName              String                   @map("project_name") @db.VarChar(200)
  siteType                 String?                  @map("site_type") @db.VarChar(100)
  expectedStartDate        DateTime?                @map("expected_start_date") @db.Date
  materialCategoryId       String?                  @map("material_category_id") @db.Uuid
  materialCategorySlug     String?                  @map("material_category_slug") @db.VarChar(120)
  materialCategoryName     String?                  @map("material_category_name") @db.VarChar(200)
  isMixedLoad              Boolean                  @default(false) @map("is_mixed_load")
  /// For Mixed Load: [{ id, slug, name }]
  materialCategoriesJson   Json?                    @map("material_categories_json") @db.JsonB
  productType              String?                  @map("product_type") @db.VarChar(50)
  grade                    String?                  @db.VarChar(50)
  materialTypeLabel        String?                  @map("material_type_label") @db.VarChar(200)
  location                 String                   @db.VarChar(300)
  addressLine              String?                  @map("address_line") @db.VarChar(300)
  city                     String?                  @db.VarChar(120)
  state                    String?                  @db.VarChar(120)
  pincode                  String?                  @db.VarChar(12)
  latitude                 Decimal?                 @db.Decimal(10, 7)
  longitude                Decimal?                 @db.Decimal(10, 7)
  addressId                String?                  @map("address_id") @db.Uuid
  remarks                  String?                  @db.Text
  additionalNotes          String?                  @map("additional_notes") @db.Text
  expectedQuantity         Decimal                  @map("expected_quantity") @db.Decimal(12, 3)
  expectedUnit             String                   @default("Bags") @map("expected_unit") @db.VarChar(50)
  deliveryRequirement      BulkDeliveryRequirement? @map("delivery_requirement")
  deliveryDate             DateTime?                @map("delivery_date") @db.Date
  preferredContact         BulkPreferredContact     @default(BOTH) @map("preferred_contact")
  status                   BulkEnquiryStatus        @default(NEW)
  assignedExecutiveId      String?                  @map("assigned_executive_id") @db.Uuid
  assignedExecutive        String?                  @map("assigned_executive") @db.VarChar(200)
  estimatedValue           Decimal?                 @map("estimated_value") @db.Decimal(14, 2)
  quotedValue              Decimal?                 @map("quoted_value") @db.Decimal(14, 2)
  convertedOrderId         String?                  @map("converted_order_id") @db.Uuid
  convertedAt              DateTime?                @map("converted_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  customer            Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  materialCategory    Category?               @relation(fields: [materialCategoryId], references: [id], onDelete: SetNull)
  address             Address?                @relation(fields: [addressId], references: [id], onDelete: SetNull)
  assignedExecutiveUser AdminUser?            @relation("BulkEnquiryAssignedExecutive", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  convertedOrder      Order?                  @relation("BulkEnquiryConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  activities          BulkEnquiryActivity[]
  followUps           BulkEnquiryFollowUp[]
  internalNotes       BulkEnquiryNote[]
  quotations          BulkEnquiryQuotation[]

  @@index([customerId])
  @@index([status])
  @@index([enquiryNumber])
  @@index([assignedExecutiveId])
  @@index([materialCategoryId])
  @@index([materialCategorySlug])
  @@index([city])
  @@index([createdAt])
  @@index([customerId, status, createdAt(sort: Desc)])
  @@index([assignedExecutiveId, status, createdAt(sort: Desc)])
  @@map("bulk_enquiries")
}

