// ─── Category ────────────────────────────────────────────────────────────────

model Category {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(120)
  name         String       @db.VarChar(200)
  nameHi       String?      @map("name_hi") @db.VarChar(200)
  description  String?      @db.Text
  imageUrl     String?      @map("image_url") @db.VarChar(500)
  iconUrl      String?      @map("icon_url") @db.VarChar(500)
  labelKey     String?      @map("label_key") @db.VarChar(80)
  displayOrder Int          @default(0) @map("display_order")
  priority     Int          @default(0)
  isFeatured   Boolean      @default(false) @map("is_featured")
  isVisible    Boolean      @default(true) @map("is_visible")
  visibility   Visibility   @default(PUBLIC)
  status       EntityStatus @default(ACTIVE)
  metaTitle    String?      @map("meta_title") @db.VarChar(200)
  metaDesc     String?      @map("meta_desc") @db.VarChar(500)
  parentId     String?      @map("parent_id") @db.Uuid
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  bulkEnquiries BulkEnquiry[]

  @@index([slug])
  @@index([status, isVisible, displayOrder])
  @@index([isFeatured, status])
  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id               String             @id @default(uuid()) @db.Uuid
  slug             String             @unique @db.VarChar(200)
  sku              String?            @unique @db.VarChar(80)
  name             String             @db.VarChar(300)
  nameHi           String?            @map("name_hi") @db.VarChar(300)
  detailName       String?            @map("detail_name") @db.VarChar(300)
  brand            String?            @db.VarChar(120)
  description      String?            @db.Text
  descriptionHi    String?            @map("description_hi") @db.Text
  categoryId       String             @map("category_id") @db.Uuid
  /// Stable product-type code (e.g. RED_BRICKS, GREY_ASH_BRICKS). Not a category.
  productType      String?            @map("product_type") @db.VarChar(50)
  grade            String?            @db.VarChar(50)
  badge            String?            @db.VarChar(100)
  badgeColor       String?            @map("badge_color") @db.VarChar(20)
  status           String             @default("IN STOCK") @db.VarChar(50)
  spec             String?            @db.VarChar(200)
  unit             String             @default("Bag") @db.VarChar(30)
  retailPrice      Decimal            @map("retail_price") @db.Decimal(12, 2)
  mrp              Decimal?           @db.Decimal(12, 2)
  bulkPrice        Decimal?           @map("bulk_price") @db.Decimal(12, 2)
  membershipPrice  Decimal?           @map("membership_price") @db.Decimal(12, 2)
  bulkMinQty       Int?               @map("bulk_min_qty")
  showBulkPricing  Boolean            @default(false) @map("show_bulk_pricing")
  stockLeft        Int                @default(0) @map("stock_left")
  deliveryETA      String?            @map("delivery_eta") @db.VarChar(100)
  bulkThreshold    Int                @default(50) @map("bulk_threshold")
  bulkLabel        String?            @map("bulk_label") @db.VarChar(100)
  /// Multi-tier bulk pricing: [{ minQty, price, label? }]
  bulkPricing      Json?              @map("bulk_pricing") @db.JsonB
  brandLogoUrl     String?            @map("brand_logo_url") @db.VarChar(500)
  minOrder         Int                @default(1) @map("min_order")
  maxOrder         Int?               @map("max_order")
  incrementStep    Int                @default(1) @map("increment_step")
  defaultQuantity  Int                @default(1) @map("default_quantity")
  hasVariants      Boolean            @default(false) @map("has_variants")
  defaultVariantId String?            @map("default_variant_id") @db.Uuid
  perPiecePrice    Decimal?           @map("per_piece_price") @db.Decimal(12, 2)
  /// Logistics: weight per sellable unit (kg). Admin-configurable — never invent.
  weightPerUnitKg  Decimal?           @map("weight_per_unit_kg") @db.Decimal(12, 3)
  /// Logistics: volume per sellable unit (CFT). Admin-configurable — never invent.
  volumePerUnitCft Decimal?           @map("volume_per_unit_cft") @db.Decimal(12, 3)
  /// WEIGHT | VOLUME | QUANTITY | MIXED — how load is measured for this SKU
  loadType         String?            @map("load_type") @db.VarChar(20)
  isTransportable  Boolean            @default(true) @map("is_transportable")
  allowDecimalQuantity Boolean        @default(false) @map("allow_decimal_quantity")
  preferredVehicleType DeliveryVehicleType? @map("preferred_vehicle_type")
  /// JSON array of DeliveryVehicleType strings; null = all active vehicles allowed
  allowedVehicleTypes Json?           @map("allowed_vehicle_types") @db.JsonB
  specs            Json?              @db.JsonB
  gst              Decimal            @default(18) @db.Decimal(5, 2)
  listingType      ProductListingType @default(STANDARD) @map("listing_type")
  displayOrder     Int                @default(0) @map("display_order")
  priority         Int                @default(0)
  isFeatured       Boolean            @default(false) @map("is_featured")
  isBestSelling    Boolean            @default(false) @map("is_best_selling")
  isVisible        Boolean            @default(true) @map("is_visible")
  visibility       Visibility         @default(PUBLIC)
  entityStatus     EntityStatus       @default(ACTIVE) @map("entity_status")
  salesCount       Int                @default(0) @map("sales_count")
  averageRating    Decimal            @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount      Int                @default(0) @map("review_count")
  metaTitle        String?            @map("meta_title") @db.VarChar(200)
  metaDesc         String?            @map("meta_desc") @db.VarChar(500)
  metaKeywords     String?            @map("meta_keywords") @db.VarChar(500)
  deletedAt        DateTime?          @map("deleted_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  offerProducts OfferProduct[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  hubInventory       HubInventory[]
  inventoryTransfers InventoryTransfer[]
  requisitionItems   RequisitionItem[]
  ledgerEntries      InventoryLedgerEntry[]
  bulkQuotations     BulkEnquiryQuotation[]

  @@index([slug])
  @@index([categoryId, entityStatus, isVisible])
  @@index([categoryId, productType, grade])
  @@index([productType])
  @@index([grade])
  @@index([listingType, entityStatus])
  @@index([isFeatured, entityStatus, isVisible])
  @@index([isBestSelling, entityStatus, isVisible])
  @@index([salesCount(sort: Desc)])
  @@index([averageRating(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  url          String    @db.VarChar(500)
  altText      String?   @map("alt_text") @db.VarChar(200)
  displayOrder Int       @default(0) @map("display_order")
  isPrimary    Boolean   @default(false) @map("is_primary")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_images")
}

model ProductVariant {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  label        String    @db.VarChar(120)
  displayUnit  String?   @map("display_unit") @db.VarChar(50)
  size         Decimal?  @db.Decimal(10, 2)
  sizeUnit     String?   @map("size_unit") @db.VarChar(20)
  count        Int?
  quantity     Int?
  price        Decimal   @db.Decimal(12, 2)
  bulkPrice    Decimal?  @map("bulk_price") @db.Decimal(12, 2)
  inStock      Boolean   @default(true) @map("in_stock")
  displayOrder Int       @default(0) @map("display_order")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_variants")
}

// ─── CMS: Banner, Offer, Video, Announcement ─────────────────────────────────

model Banner {
  id                   String          @id @default(uuid()) @db.Uuid
  slug                 String          @unique @db.VarChar(120)
  title                String          @db.VarChar(200)
  subtitle             String?         @db.VarChar(300)
  imageUrl             String          @map("image_url") @db.VarChar(500)
  mobileUrl            String?         @map("mobile_url") @db.VarChar(500)
  tabletUrl            String?         @map("tablet_url") @db.VarChar(500)
  desktopUrl           String?         @map("desktop_url") @db.VarChar(500)
  videoUrl             String?         @map("video_url") @db.VarChar(500)
  thumbnailUrl         String?         @map("thumbnail_url") @db.VarChar(500)
  badge                String?         @db.VarChar(100)
  bannerType           BannerType      @default(IMAGE) @map("banner_type")
  ctaLabel             String?         @map("cta_label") @db.VarChar(100)
  ctaColor             String?         @map("cta_color") @db.VarChar(30)
  backgroundColor      String?         @map("background_color") @db.VarChar(30)
  buttonAction         String?         @map("button_action") @db.VarChar(100)
  linkUrl              String?         @map("link_url") @db.VarChar(500)
  linkType             String?         @map("link_type") @db.VarChar(50)
  linkTarget           String?         @map("link_target") @db.VarChar(200)
  secondaryCtaLabel    String?         @map("secondary_cta_label") @db.VarChar(100)
  secondaryLinkUrl     String?         @map("secondary_link_url") @db.VarChar(500)
  secondaryLinkType    String?         @map("secondary_link_type") @db.VarChar(50)
  secondaryLinkTarget  String?         @map("secondary_link_target") @db.VarChar(200)
  placement            BannerPlacement @default(HOME_HERO)
  displayOrder         Int             @default(0) @map("display_order")
  priority             Int             @default(0)
  startsAt             DateTime?       @map("starts_at")
  endsAt               DateTime?       @map("ends_at")
  isVisible            Boolean         @default(true) @map("is_visible")
  visibility           Visibility      @default(PUBLIC)
  status               EntityStatus    @default(ACTIVE)
  deletedAt            DateTime?       @map("deleted_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([placement, status, isVisible, displayOrder])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("banners")
}

