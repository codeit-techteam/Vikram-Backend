}

model NotificationToken {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  token      String         @db.VarChar(500)
  platform   DevicePlatform @default(ANDROID)
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, token])
  @@index([customerId, isActive])
  @@map("notification_tokens")
}

model Address {
  id             String      @id @default(uuid()) @db.Uuid
  customerId     String      @map("customer_id") @db.Uuid
  label          String?     @db.VarChar(100)
  type           AddressType @default(DELIVERY)
  siteType       SiteType?   @map("site_type")
  contactPerson  String?     @map("contact_person") @db.VarChar(150)
  phone          String?     @db.VarChar(20)
  line1          String      @db.VarChar(300)
  line2          String?     @db.VarChar(300)
  landmark       String?     @db.VarChar(200)
  gateNumber     String?     @map("gate_number") @db.VarChar(50)
  floor          String?     @db.VarChar(50)
  city           String      @db.VarChar(100)
  state          String      @db.VarChar(100)
  country        String      @default("India") @db.VarChar(100)
  pincode        String      @db.VarChar(10)
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  deliveryNotes  String?     @map("delivery_notes") @db.Text
  isDefault      Boolean     @default(false) @map("is_default")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]
  bulkEnquiries BulkEnquiry[]

  @@index([customerId, type])
  @@index([customerId, isDefault])
  @@index([pincode])
  @@index([deletedAt])
  @@map("addresses")
}

// ─── Wishlist ────────────────────────────────────────────────────────────────

model Wishlist {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @unique @map("customer_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  customerId   String?          @map("customer_id") @db.Uuid
  type         NotificationType
  label        String           @db.VarChar(100)
  title        String           @db.VarChar(300)
  body         String           @db.Text
  actionLabel  String?          @map("action_label") @db.VarChar(100)
  actionRoute  String?          @map("action_route") @db.VarChar(200)
  actionVariant String?         @map("action_variant") @db.VarChar(20)
  isRead       Boolean          @default(false) @map("is_read")
  isGlobal     Boolean          @default(false) @map("is_global")
  priority     Int              @default(0)
  deletedAt    DateTime?        @map("deleted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isRead, createdAt(sort: Desc)])
  @@index([isGlobal, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("notifications")
}

// ─── Hub & Inventory ─────────────────────────────────────────────────────────

model Hub {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique @db.VarChar(40)
  name              String       @db.VarChar(200)
  addressLine1      String       @map("address_line1") @db.VarChar(300)
  addressLine2      String?      @map("address_line2") @db.VarChar(300)
  city              String       @db.VarChar(100)
  state             String       @db.VarChar(100)
  pincode           String       @db.VarChar(10)
  latitude          Decimal      @db.Decimal(10, 7)
  longitude         Decimal      @db.Decimal(10, 7)
  phone             String?      @db.VarChar(15)
  email             String?      @db.VarChar(255)
  capacity          Int?
  workingHours      String?      @map("working_hours") @db.VarChar(200)
  hubType           String?      @map("hub_type") @db.VarChar(50)
  warehouseId       String?      @map("warehouse_id") @db.VarChar(100)
  warehouseCode     String?      @map("warehouse_code") @db.VarChar(40)
  serviceRadiusKm   Decimal      @default(15) @map("service_radius_km") @db.Decimal(8, 2)
  coveragePincodes  String[]     @default([]) @map("coverage_pincodes")
  coveragePolygon   Json?        @map("coverage_polygon")
  createdByAdminId  String?      @map("created_by_admin_id") @db.Uuid
  isActive          Boolean      @default(true) @map("is_active")
  status            EntityStatus @default(ACTIVE)
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  inventory         HubInventory[]
  orders            Order[]
  users             HubUser[]
  drivers           Driver[]
  warehouseDrivers  Driver[]            @relation("DriverWarehouseHub")
  vehicles          Vehicle[]           @relation("VehicleAssignedHub")
  warehouseVehicles Vehicle[]           @relation("VehicleWarehouseHub")
  loadingRecords    HubLoadingRecord[]
  unloadingRecords  HubUnloadingRecord[]
  dispatches        HubDispatch[]
  notifications     HubNotification[]
  transfersFrom     InventoryTransfer[] @relation("TransferFromHub")
  transfersTo       InventoryTransfer[] @relation("TransferToHub")
  settlementBatches SettlementBatch[]
  requisitions      Requisition[]       @relation("RequisitionHub")
  warehouseRequisitions Requisition[]   @relation("RequisitionWarehouseHub")
  ledgerEntries     InventoryLedgerEntry[]
  assignedCustomers Customer[]          @relation("CustomerAssignedHub")

  @@index([isActive, status])
  @@index([pincode])
  @@index([latitude, longitude])
  @@index([deletedAt])
  @@index([hubType])
  @@map("hubs")
}

model HubInventory {
  id                String   @id @default(uuid()) @db.Uuid
  hubId             String   @map("hub_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  availableQty      Int      @default(0) @map("available_qty")
  reservedQty       Int      @default(0) @map("reserved_qty")
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  minimumStock      Int      @default(0) @map("minimum_stock")
  maximumStock      Int?     @map("maximum_stock")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  hub     Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([hubId, productId])
  @@index([productId, availableQty])
  @@index([hubId])
  @@map("hub_inventory")
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid()) @db.Uuid
  cartId       String   @map("cart_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  hubId        String?  @map("hub_id") @db.Uuid
  quantity     Int      @default(1)
  price        Decimal  @db.Decimal(12, 2)
  gst          Decimal  @db.Decimal(5, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  bulkDiscount Decimal  @default(0) @map("bulk_discount") @db.Decimal(12, 2)
  etaMinutes   Int?     @map("eta_minutes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@index([hubId])
  @@map("cart_items")
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number") @db.VarChar(30)
  customerId      String        @map("customer_id") @db.Uuid
  addressId       String        @map("address_id") @db.Uuid
  hubId           String?       @map("hub_id") @db.Uuid
  orderStatus     OrderStatus   @default(PENDING) @map("order_status")
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  subtotal        Decimal       @db.Decimal(12, 2)
  gstAmount       Decimal       @default(0) @map("gst_amount") @db.Decimal(12, 2)
  deliveryCharge  Decimal       @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  grandTotal      Decimal       @map("grand_total") @db.Decimal(12, 2)
  isEmergency         Boolean       @default(false) @map("is_emergency")
  loyaltyPointsUsed   Int           @default(0) @map("loyalty_points_used")
  membershipDiscount  Decimal       @default(0) @map("membership_discount") @db.Decimal(12, 2)
  bulkOrder           Boolean       @default(false) @map("bulk_procurement")
  loadingCharges      Decimal       @default(0) @map("loading_charges") @db.Decimal(12, 2)
  unloadingCharges    Decimal       @default(0) @map("unloading_charges") @db.Decimal(12, 2)
  bikeDeliveryFree    Boolean       @default(false) @map("bike_delivery_free")
  /// Company-absorbed bike delivery cost when free-delivery benefit is used
  companyAbsorbedDelivery Decimal    @default(0) @map("company_absorbed_delivery") @db.Decimal(12, 2)
  /// Snapshot of pricing used at order confirmation (never recalculated)
  deliveryPricingRuleId String?     @map("delivery_pricing_rule_id") @db.Uuid
  deliveryVehicleType DeliveryVehicleType? @map("delivery_vehicle_type")
  deliveryDistanceKm  Decimal?      @map("delivery_distance_km") @db.Decimal(8, 2)
  deliveryPricingVersion Int?       @map("delivery_pricing_version")
  freeDeliveryApplied Boolean       @default(false) @map("free_delivery_applied")
  /// Snapshot of load / capacity used at confirmation (never recalculated)
  deliveryVehicleCount Int?         @map("delivery_vehicle_count")
  deliveryTotalWeightKg Decimal?    @map("delivery_total_weight_kg") @db.Decimal(12, 3)
  deliveryTotalVolumeCft Decimal?   @map("delivery_total_volume_cft") @db.Decimal(12, 3)
  deliveryTotalQuantity Decimal?    @map("delivery_total_quantity") @db.Decimal(12, 3)
  deliveryCapacityUsed Decimal?     @map("delivery_capacity_used") @db.Decimal(12, 3)
  deliveryCapacityLimit Decimal?    @map("delivery_capacity_limit") @db.Decimal(12, 3)
  deliveryFreeReason  String?       @map("delivery_free_reason") @db.VarChar(120)
  deliveryRequiresBulkQuote Boolean @default(false) @map("delivery_requires_bulk_quote")
  deliveryMultiVehicle Boolean      @default(false) @map("delivery_multi_vehicle")
  priorityOrder       Boolean       @default(false) @map("priority_order")
  assignedDriverId    String?       @map("assigned_driver_id") @db.Uuid
  assignedVehicleId   String?       @map("assigned_vehicle_id") @db.Uuid
  assignedLoaderId    String?       @map("assigned_loader_id") @db.Uuid
  managerId           String?       @map("manager_id") @db.Uuid
  expectedDeliveryAt  DateTime?     @map("expected_delivery_at")
  loadingStartedAt    DateTime?     @map("loading_started_at")
  loadingCompletedAt  DateTime?     @map("loading_completed_at")
  dispatchedAt        DateTime?     @map("dispatched_at")
  driverReachedAt     DateTime?     @map("driver_reached_at")
  deliveryOtp         String?       @map("delivery_otp") @db.VarChar(6)
  deliveryOtpGeneratedAt DateTime?  @map("delivery_otp_generated_at")
  deliveryOtpVerified Boolean       @default(false) @map("delivery_otp_verified")
  deliveryVerifiedBy  String?       @map("delivery_verified_by") @db.VarChar(100)
  deliveryCompletedAt DateTime?     @map("delivery_completed_at")
  paymentCollectedAt  DateTime?     @map("payment_collected_at")
  hubRejectReason     String?       @map("hub_reject_reason") @db.VarChar(500)
  hubRejectedAt       DateTime?     @map("hub_rejected_at")
  deliveryAddress Json?         @map("delivery_address") @db.JsonB
  notes           String?       @db.Text
  cancelReason    String?       @map("cancel_reason") @db.VarChar(500)
  cancelledAt     DateTime?     @map("cancelled_at")
  deliveredAt     DateTime?     @map("delivered_at")
  /// APP | CUSTOMER_EXECUTIVE | SUPER_ADMIN | HUB
  orderSource     String?       @map("order_source") @db.VarChar(40)
  createdByAdminId String?      @map("created_by_admin_id") @db.Uuid
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer       Customer        @relation(fields: [customerId], references: [id])
  address        Address         @relation(fields: [addressId], references: [id])
  hub            Hub?            @relation(fields: [hubId], references: [id], onDelete: SetNull)
  manager        HubUser?        @relation("OrderManager", fields: [managerId], references: [id], onDelete: SetNull)
  assignedDriver Driver?         @relation("OrderAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedVehicle Vehicle?       @relation("OrderAssignedVehicle", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignedLoader HubUser?        @relation("OrderAssignedLoader", fields: [assignedLoaderId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  timeline       OrderTimeline[]
  invoice        Invoice?
  reviews        Review[]
  supportTickets SupportTicket[]
  emergencyOrder EmergencyOrder?
  loadingRecord  HubLoadingRecord?
  unloadingRecord HubUnloadingRecord?
  dispatch       HubDispatch?
  proofOfDelivery ProofOfDelivery?
  refunds         Refund[]
  paymentLinks    PaymentLink[]
  bulkEnquiries   BulkEnquiry[] @relation("BulkEnquiryConvertedOrder")

  @@index([customerId, orderStatus, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([hubId, orderStatus])
  @@index([assignedDriverId])
  @@index([assignedVehicleId])
  @@index([assignedLoaderId])
  @@index([addressId])
  @@index([orderNumber])
  @@index([orderSource])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  name         String   @db.VarChar(300)
  productImage String?  @map("product_image") @db.VarChar(500)
  sku          String?  @db.VarChar(80)
  brand        String?  @db.VarChar(120)
  category     String?  @db.VarChar(120)
  /// Snapshot of productType code at order time (e.g. RED_BRICKS)
  productType  String?  @map("product_type") @db.VarChar(50)
  /// Snapshot of grade code/label at order time (e.g. A_PLUS)
  grade        String?  @db.VarChar(50)
  variant      String?  @db.VarChar(120)
  quantity     Int
  unit         String   @db.VarChar(30)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  gst          Decimal  @default(0) @db.Decimal(5, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model PaymentLink {
  id                 String            @id @default(uuid()) @db.Uuid
  customerId         String            @map("customer_id") @db.Uuid
  orderId            String            @map("order_id") @db.Uuid
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("INR") @db.VarChar(10)
  status             PaymentLinkStatus @default(CREATED)
  paymentUrl         String            @map("payment_url") @db.VarChar(500)
  publicToken        String            @unique @map("public_token") @db.VarChar(64)
  createdById        String?           @map("created_by_id") @db.Uuid
  reminderCount      Int               @default(0) @map("reminder_count")
  notificationStatus String?           @map("notification_status") @db.VarChar(40)
  sentAt             DateTime?         @map("sent_at")
  openedAt           DateTime?         @map("opened_at")
  paidAt             DateTime?         @map("paid_at")
  expiresAt          DateTime          @map("expires_at")
  metadata           Json?             @db.JsonB
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy AdminUser? @relation("PaymentLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customerId, status, createdAt(sort: Desc)])
  @@index([orderId])
  @@index([createdById])
  @@index([status, expiresAt])
  @@map("payment_links")
}

model OrderTimeline {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
