// ─── Category ────────────────────────────────────────────────────────────────

model Category {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(120)
  name         String       @db.VarChar(200)
  nameHi       String?      @map("name_hi") @db.VarChar(200)
  description  String?      @db.Text
  imageUrl     String?      @map("image_url") @db.VarChar(500)
  iconUrl      String?      @map("icon_url") @db.VarChar(500)
  labelKey     String?      @map("label_key") @db.VarChar(80)
  displayOrder Int          @default(0) @map("display_order")
  priority     Int          @default(0)
  isFeatured   Boolean      @default(false) @map("is_featured")
  isVisible    Boolean      @default(true) @map("is_visible")
  visibility   Visibility   @default(PUBLIC)
  status       EntityStatus @default(ACTIVE)
  metaTitle    String?      @map("meta_title") @db.VarChar(200)
  metaDesc     String?      @map("meta_desc") @db.VarChar(500)
  parentId     String?      @map("parent_id") @db.Uuid
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([status, isVisible, displayOrder])
  @@index([isFeatured, status])
  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id               String             @id @default(uuid()) @db.Uuid
  slug             String             @unique @db.VarChar(200)
  sku              String?            @unique @db.VarChar(80)
  name             String             @db.VarChar(300)
  nameHi           String?            @map("name_hi") @db.VarChar(300)
  detailName       String?            @map("detail_name") @db.VarChar(300)
  brand            String?            @db.VarChar(120)
  description      String?            @db.Text
  descriptionHi    String?            @map("description_hi") @db.Text
  categoryId       String             @map("category_id") @db.Uuid
  grade            String?            @db.VarChar(50)
  badge            String?            @db.VarChar(100)
  badgeColor       String?            @map("badge_color") @db.VarChar(20)
  status           String             @default("IN STOCK") @db.VarChar(50)
  spec             String?            @db.VarChar(200)
  unit             String             @default("Bag") @db.VarChar(30)
  retailPrice      Decimal            @map("retail_price") @db.Decimal(12, 2)
  mrp              Decimal?           @db.Decimal(12, 2)
  bulkPrice        Decimal?           @map("bulk_price") @db.Decimal(12, 2)
  membershipPrice  Decimal?           @map("membership_price") @db.Decimal(12, 2)
  bulkMinQty       Int?               @map("bulk_min_qty")
  showBulkPricing  Boolean            @default(false) @map("show_bulk_pricing")
  stockLeft        Int                @default(0) @map("stock_left")
  deliveryETA      String?            @map("delivery_eta") @db.VarChar(100)
  bulkThreshold    Int                @default(50) @map("bulk_threshold")
  bulkLabel        String?            @map("bulk_label") @db.VarChar(100)
  /// Multi-tier bulk pricing: [{ minQty, price, label? }]
  bulkPricing      Json?              @map("bulk_pricing") @db.JsonB
  brandLogoUrl     String?            @map("brand_logo_url") @db.VarChar(500)
  minOrder         Int                @default(1) @map("min_order")
  maxOrder         Int?               @map("max_order")
  incrementStep    Int                @default(1) @map("increment_step")
  defaultQuantity  Int                @default(1) @map("default_quantity")
  hasVariants      Boolean            @default(false) @map("has_variants")
  defaultVariantId String?            @map("default_variant_id") @db.Uuid
  perPiecePrice    Decimal?           @map("per_piece_price") @db.Decimal(12, 2)
  specs            Json?              @db.JsonB
  gst              Decimal            @default(18) @db.Decimal(5, 2)
  listingType      ProductListingType @default(STANDARD) @map("listing_type")
  displayOrder     Int                @default(0) @map("display_order")
  priority         Int                @default(0)
  isFeatured       Boolean            @default(false) @map("is_featured")
  isBestSelling    Boolean            @default(false) @map("is_best_selling")
  isVisible        Boolean            @default(true) @map("is_visible")
  visibility       Visibility         @default(PUBLIC)
  entityStatus     EntityStatus       @default(ACTIVE) @map("entity_status")
  salesCount       Int                @default(0) @map("sales_count")
  averageRating    Decimal            @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount      Int                @default(0) @map("review_count")
  metaTitle        String?            @map("meta_title") @db.VarChar(200)
  metaDesc         String?            @map("meta_desc") @db.VarChar(500)
  metaKeywords     String?            @map("meta_keywords") @db.VarChar(500)
  deletedAt        DateTime?          @map("deleted_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  category      Category         @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  offerProducts OfferProduct[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  hubInventory       HubInventory[]
  inventoryTransfers InventoryTransfer[]
  requisitionItems   RequisitionItem[]
  ledgerEntries      InventoryLedgerEntry[]

  @@index([slug])
  @@index([categoryId, entityStatus, isVisible])
  @@index([listingType, entityStatus])
  @@index([isFeatured, entityStatus, isVisible])
  @@index([isBestSelling, entityStatus, isVisible])
  @@index([salesCount(sort: Desc)])
  @@index([averageRating(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  url          String    @db.VarChar(500)
  altText      String?   @map("alt_text") @db.VarChar(200)
  displayOrder Int       @default(0) @map("display_order")
  isPrimary    Boolean   @default(false) @map("is_primary")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_images")
}

model ProductVariant {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  label        String    @db.VarChar(120)
  displayUnit  String?   @map("display_unit") @db.VarChar(50)
  size         Decimal?  @db.Decimal(10, 2)
  sizeUnit     String?   @map("size_unit") @db.VarChar(20)
  count        Int?
  quantity     Int?
  price        Decimal   @db.Decimal(12, 2)
  bulkPrice    Decimal?  @map("bulk_price") @db.Decimal(12, 2)
  inStock      Boolean   @default(true) @map("in_stock")
  displayOrder Int       @default(0) @map("display_order")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_variants")
}

// ─── CMS: Banner, Offer, Video, Announcement ─────────────────────────────────

model Banner {
  id                   String          @id @default(uuid()) @db.Uuid
  slug                 String          @unique @db.VarChar(120)
  title                String          @db.VarChar(200)
  subtitle             String?         @db.VarChar(300)
  imageUrl             String          @map("image_url") @db.VarChar(500)
  mobileUrl            String?         @map("mobile_url") @db.VarChar(500)
  tabletUrl            String?         @map("tablet_url") @db.VarChar(500)
  desktopUrl           String?         @map("desktop_url") @db.VarChar(500)
  videoUrl             String?         @map("video_url") @db.VarChar(500)
  thumbnailUrl         String?         @map("thumbnail_url") @db.VarChar(500)
  badge                String?         @db.VarChar(100)
  bannerType           BannerType      @default(IMAGE) @map("banner_type")
  ctaLabel             String?         @map("cta_label") @db.VarChar(100)
  ctaColor             String?         @map("cta_color") @db.VarChar(30)
  backgroundColor      String?         @map("background_color") @db.VarChar(30)
  buttonAction         String?         @map("button_action") @db.VarChar(100)
  linkUrl              String?         @map("link_url") @db.VarChar(500)
  linkType             String?         @map("link_type") @db.VarChar(50)
  linkTarget           String?         @map("link_target") @db.VarChar(200)
  secondaryCtaLabel    String?         @map("secondary_cta_label") @db.VarChar(100)
  secondaryLinkUrl     String?         @map("secondary_link_url") @db.VarChar(500)
  secondaryLinkType    String?         @map("secondary_link_type") @db.VarChar(50)
  secondaryLinkTarget  String?         @map("secondary_link_target") @db.VarChar(200)
  placement            BannerPlacement @default(HOME_HERO)
  displayOrder         Int             @default(0) @map("display_order")
  priority             Int             @default(0)
  startsAt             DateTime?       @map("starts_at")
  endsAt               DateTime?       @map("ends_at")
  isVisible            Boolean         @default(true) @map("is_visible")
  visibility           Visibility      @default(PUBLIC)
  status               EntityStatus    @default(ACTIVE)
  deletedAt            DateTime?       @map("deleted_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  @@index([placement, status, isVisible, displayOrder])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("banners")
}

model Advertisement {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(120)
  title        String       @db.VarChar(200)
  brandName    String       @map("brand_name") @db.VarChar(120)
  description  String?      @db.Text
  imageUrl     String       @map("image_url") @db.VarChar(500)
  logoUrl      String?      @map("logo_url") @db.VarChar(500)
  buttonText   String?      @map("button_text") @db.VarChar(100)
  redirectType RedirectType @default(NONE) @map("redirect_type")
  redirectId   String?      @map("redirect_id") @db.VarChar(200)
  displayOrder Int          @default(0) @map("display_order")
  priority     Int          @default(0)
  startsAt     DateTime?    @map("starts_at")
  endsAt       DateTime?    @map("ends_at")
  isActive     Boolean      @default(true) @map("is_active")
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("advertisements")
}

model PromotionalCard {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(120)
  title        String       @db.VarChar(200)
  subtitle     String?      @db.VarChar(300)
  description  String?      @db.Text
  imageUrl     String?      @map("image_url") @db.VarChar(500)
  buttonText   String?      @map("button_text") @db.VarChar(100)
  badge        String?      @db.VarChar(100)
  benefits     Json?
  redirectType RedirectType @default(NONE) @map("redirect_type")
  redirectId   String?      @map("redirect_id") @db.VarChar(200)
  cardType     String       @map("card_type") @db.VarChar(50)
  priority     Int          @default(0)
  displayOrder Int          @default(0) @map("display_order")
  startsAt     DateTime?    @map("starts_at")
  endsAt       DateTime?    @map("ends_at")
  isActive     Boolean      @default(true) @map("is_active")
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@index([cardType, isActive])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("promotional_cards")
}

model QuickAction {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(120)
  label        String       @db.VarChar(100)
  iconUrl      String?      @map("icon_url") @db.VarChar(500)
  iconKey      String?      @map("icon_key") @db.VarChar(80)
  redirectType RedirectType @default(ROUTE) @map("redirect_type")
  redirectId   String?      @map("redirect_id") @db.VarChar(200)
  displayOrder Int          @default(0) @map("display_order")
  isVisible    Boolean      @default(true) @map("is_visible")
  startsAt     DateTime?    @map("starts_at")
  endsAt       DateTime?    @map("ends_at")
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([isVisible, displayOrder])
  @@index([deletedAt])
  @@map("quick_actions")
}

model HomeSection {
  id           String          @id @default(uuid()) @db.Uuid
  sectionType  HomeSectionType @map("section_type")
  title        String?         @db.VarChar(200)
  subtitle     String?         @db.VarChar(300)
  displayOrder Int             @default(0) @map("display_order")
  enabled      Boolean         @default(true)
  apiSource    String?         @map("api_source") @db.VarChar(120)
  layoutType   String?         @map("layout_type") @db.VarChar(50)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([sectionType])
  @@index([enabled, displayOrder])
  @@map("home_sections")
}

model Offer {
  id              String       @id @default(uuid()) @db.Uuid
  slug            String       @unique @db.VarChar(120)
  title           String       @db.VarChar(200)
  titleHi         String?      @map("title_hi") @db.VarChar(200)
  description     String?      @db.Text
  imageUrl        String?      @map("image_url") @db.VarChar(500)
  offerType       OfferType    @default(BUNDLE) @map("offer_type")
  discountLabel   String?      @map("discount_label") @db.VarChar(100)
  discountValue   Decimal?     @map("discount_value") @db.Decimal(12, 2)
  discountPercent Decimal?     @map("discount_percent") @db.Decimal(5, 2)
  bundlePrice     Decimal?     @map("bundle_price") @db.Decimal(12, 2)
  originalPrice   Decimal?     @map("original_price") @db.Decimal(12, 2)
  badge           String?      @db.VarChar(100)
  displayOrder    Int          @default(0) @map("display_order")
  priority        Int          @default(0)
  startsAt        DateTime?    @map("starts_at")
  endsAt          DateTime?    @map("ends_at")
  isFeatured      Boolean      @default(false) @map("is_featured")
  isVisible       Boolean      @default(true) @map("is_visible")
  visibility      Visibility   @default(PUBLIC)
  status          EntityStatus @default(ACTIVE)
  metaTitle       String?      @map("meta_title") @db.VarChar(200)
  metaDesc        String?      @map("meta_desc") @db.VarChar(500)
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  products OfferProduct[]

  @@index([slug])
  @@index([status, isVisible, isFeatured, displayOrder])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
  @@map("offers")
}

model OfferProduct {
  id           String    @id @default(uuid()) @db.Uuid
  offerId      String    @map("offer_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  quantity     Int       @default(1)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([offerId, productId])
  @@index([offerId])
  @@index([productId])
  @@map("offer_products")
}

model Video {
  id           String         @id @default(uuid()) @db.Uuid
  slug         String         @unique @db.VarChar(120)
  title        String         @db.VarChar(200)
  description  String?        @db.Text
  storageKey   String?        @map("storage_key") @db.VarChar(500)
  videoUrl     String         @map("video_url") @db.VarChar(2000)
  publicUrl    String?        @map("public_url") @db.VarChar(2000)
  thumbnailUrl String?        @map("thumbnail_url") @db.VarChar(2000)
  thumbnailKey String?        @map("thumbnail_key") @db.VarChar(500)
  mimeType     String?        @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt?        @map("size_bytes")
  duration     Int?
  placement    VideoPlacement @default(HOME_HERO_VIDEO)
  linkUrl      String?        @map("link_url") @db.VarChar(1000)
  linkTarget   String?        @map("link_target") @db.VarChar(200)
  ctaLabel     String?        @map("cta_label") @db.VarChar(100)
  displayOrder Int            @default(0) @map("display_order")
  priority     Int            @default(0)
  isVisible    Boolean        @default(true) @map("is_visible")
  published    Boolean        @default(false)
  visibility   Visibility     @default(PUBLIC)
  status       EntityStatus   @default(ACTIVE)
  scheduledAt  DateTime?      @map("scheduled_at")
  expiresAt    DateTime?      @map("expires_at")
  createdBy    String?        @map("created_by") @db.Uuid
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([placement, status, isVisible, displayOrder])
  @@index([placement, published, priority])
  @@index([deletedAt])
  @@map("videos")
}

model Announcement {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique @db.VarChar(120)
  title        String       @db.VarChar(200)
  body         String?      @db.Text
  imageUrl     String?      @map("image_url") @db.VarChar(500)
  linkUrl      String?      @map("link_url") @db.VarChar(500)
  linkTarget   String?      @map("link_target") @db.VarChar(200)
  displayOrder Int          @default(0) @map("display_order")
  startsAt     DateTime?    @map("starts_at")
  endsAt       DateTime?    @map("ends_at")
  isVisible    Boolean      @default(true) @map("is_visible")
  status       EntityStatus @default(ACTIVE)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([status, isVisible, displayOrder])
  @@index([deletedAt])
  @@map("announcements")
}

// ─── Customer Auth & Profile ─────────────────────────────────────────────────

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  slug         String   @unique @db.VarChar(50)
  description  String?  @db.VarChar(300)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customers Customer[]

  @@index([isActive, displayOrder])
  @@map("roles")
}

model Customer {
  id               String         @id @default(uuid()) @db.Uuid
  phone            String         @unique @db.VarChar(15)
  email            String?        @unique @db.VarChar(200)
  passwordHash     String?        @map("password_hash") @db.VarChar(255)
  fullName         String?        @map("full_name") @db.VarChar(200)
  roleId           String?        @map("role_id") @db.Uuid
  membershipId     String?        @unique @map("membership_id") @db.Uuid
  loyaltyAccountId String?        @unique @map("loyalty_account_id") @db.Uuid
  isVerified       Boolean        @default(false) @map("is_verified")
  isMember         Boolean        @default(false) @map("is_member")
  status           CustomerStatus @default(ACTIVE)
  roleSelected     Boolean        @default(false) @map("role_selected")
  profileCompleted Boolean        @default(false) @map("profile_completed")
  language         String         @default("en") @db.VarChar(10)
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  role               Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  profile            CustomerProfile?
  addresses          Address[]
  refreshTokens      RefreshToken[]
  otpRecords         OtpRecord[]
  deviceSessions     DeviceSession[]
  notificationTokens NotificationToken[]
  wishlist           Wishlist?
  cart               Cart?
  notifications      Notification[]
  scheduledNotifications ScheduledNotification[]
  orders             Order[]
  reviews            Review[]
  supportTickets SupportTicket[]
  supportMessages  SupportMessage[]
  searchHistory      SearchHistory[]
  activeMembership   CustomerMembership? @relation("ActiveMembership", fields: [membershipId], references: [id], onDelete: SetNull)
  loyaltyByPointer   LoyaltyAccount?     @relation("CustomerLoyaltyPointer", fields: [loyaltyAccountId], references: [id], onDelete: SetNull)
  loyaltyAccount     LoyaltyAccount?       @relation("LoyaltyCustomerOwner")
  memberships        CustomerMembership[] @relation("MembershipHistory")
  bulkEnquiries      BulkEnquiry[]
  emergencyOrders    EmergencyOrder[]
  refunds            Refund[]

  @@index([phone])
  @@index([roleId])
  @@index([status])
  @@index([isMember])
  @@index([membershipId])
  @@index([loyaltyAccountId])
  @@index([deletedAt])
  @@map("customers")
}

model CustomerProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  customerId         String    @unique @map("customer_id") @db.Uuid
  companyName        String?   @map("company_name") @db.VarChar(200)
  legalEntityName    String?   @map("legal_entity_name") @db.VarChar(300)
  establishmentDate  DateTime? @map("establishment_date") @db.Date
  registeredAddress  String?   @map("registered_address") @db.VarChar(500)
  gstNumber          String?   @map("gst_number") @db.VarChar(20)
  gstVerified        Boolean   @default(false) @map("gst_verified")
  gstVerifiedAt      DateTime? @map("gst_verified_at")
  jurisdiction       String?   @db.VarChar(200)
  panNumber          String?   @map("pan_number") @db.VarChar(15)
  businessType       String?   @map("business_type") @db.VarChar(100)
  profileImage       String?   @map("profile_image") @db.VarChar(500)
  adminNotes         String?   @map("admin_notes") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(255)
  deviceId   String?  @map("device_id") @db.VarChar(100)
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isRevoked])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpRecord {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  phone      String   @db.VarChar(15)
  otpHash    String   @map("otp_hash") @db.VarChar(255)
  purpose    String   @default("LOGIN") @db.VarChar(30)
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false) @map("is_used")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_records")
}

model DeviceSession {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  deviceId   String         @map("device_id") @db.VarChar(100)
  fcmToken   String?        @map("fcm_token") @db.VarChar(500)
  platform   DevicePlatform @default(ANDROID)
  lastLogin  DateTime       @default(now()) @map("last_login")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, deviceId])
  @@index([customerId, lastLogin(sort: Desc)])
  @@map("device_sessions")
}

model NotificationToken {
  id         String         @id @default(uuid()) @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  token      String         @db.VarChar(500)
  platform   DevicePlatform @default(ANDROID)
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, token])
  @@index([customerId, isActive])
  @@map("notification_tokens")
}

model Address {
  id             String      @id @default(uuid()) @db.Uuid
  customerId     String      @map("customer_id") @db.Uuid
  label          String?     @db.VarChar(100)
  type           AddressType @default(DELIVERY)
  siteType       SiteType?   @map("site_type")
  contactPerson  String?     @map("contact_person") @db.VarChar(150)
  phone          String?     @db.VarChar(20)
  line1          String      @db.VarChar(300)
  line2          String?     @db.VarChar(300)
  landmark       String?     @db.VarChar(200)
  gateNumber     String?     @map("gate_number") @db.VarChar(50)
  floor          String?     @db.VarChar(50)
  city           String      @db.VarChar(100)
  state          String      @db.VarChar(100)
  country        String      @default("India") @db.VarChar(100)
  pincode        String      @db.VarChar(10)
  latitude       Decimal?    @db.Decimal(10, 7)
  longitude      Decimal?    @db.Decimal(10, 7)
  deliveryNotes  String?     @map("delivery_notes") @db.Text
  isDefault      Boolean     @default(false) @map("is_default")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId, type])
  @@index([customerId, isDefault])
  @@index([pincode])
  @@index([deletedAt])
  @@map("addresses")
}

// ─── Wishlist ────────────────────────────────────────────────────────────────

model Wishlist {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @unique @map("customer_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  customerId   String?          @map("customer_id") @db.Uuid
  type         NotificationType
  label        String           @db.VarChar(100)
  title        String           @db.VarChar(300)
  body         String           @db.Text
  actionLabel  String?          @map("action_label") @db.VarChar(100)
  actionRoute  String?          @map("action_route") @db.VarChar(200)
  actionVariant String?         @map("action_variant") @db.VarChar(20)
  isRead       Boolean          @default(false) @map("is_read")
  isGlobal     Boolean          @default(false) @map("is_global")
  priority     Int              @default(0)
  deletedAt    DateTime?        @map("deleted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, isRead, createdAt(sort: Desc)])
  @@index([isGlobal, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("notifications")
}

// ─── Hub & Inventory ─────────────────────────────────────────────────────────

model Hub {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique @db.VarChar(40)
  name              String       @db.VarChar(200)
  addressLine1      String       @map("address_line1") @db.VarChar(300)
  addressLine2      String?      @map("address_line2") @db.VarChar(300)
  city              String       @db.VarChar(100)
  state             String       @db.VarChar(100)
  pincode           String       @db.VarChar(10)
  latitude          Decimal      @db.Decimal(10, 7)
  longitude         Decimal      @db.Decimal(10, 7)
  phone             String?      @db.VarChar(15)
  email             String?      @db.VarChar(255)
  capacity          Int?
  workingHours      String?      @map("working_hours") @db.VarChar(200)
  hubType           String?      @map("hub_type") @db.VarChar(50)
  warehouseId       String?      @map("warehouse_id") @db.VarChar(100)
  warehouseCode     String?      @map("warehouse_code") @db.VarChar(40)
  serviceRadiusKm   Decimal      @default(15) @map("service_radius_km") @db.Decimal(8, 2)
  coveragePincodes  String[]     @default([]) @map("coverage_pincodes")
  coveragePolygon   Json?        @map("coverage_polygon")
  createdByAdminId  String?      @map("created_by_admin_id") @db.Uuid
  isActive          Boolean      @default(true) @map("is_active")
  status            EntityStatus @default(ACTIVE)
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  inventory         HubInventory[]
  orders            Order[]
  users             HubUser[]
  drivers           Driver[]
  vehicles          Vehicle[]
  loadingRecords    HubLoadingRecord[]
  unloadingRecords  HubUnloadingRecord[]
  dispatches        HubDispatch[]
  notifications     HubNotification[]
  transfersFrom     InventoryTransfer[] @relation("TransferFromHub")
  transfersTo       InventoryTransfer[] @relation("TransferToHub")
  settlementBatches SettlementBatch[]
  requisitions      Requisition[]       @relation("RequisitionHub")
  warehouseRequisitions Requisition[]   @relation("RequisitionWarehouseHub")
  ledgerEntries     InventoryLedgerEntry[]

  @@index([isActive, status])
  @@index([pincode])
  @@index([latitude, longitude])
  @@index([deletedAt])
  @@map("hubs")
}

model HubInventory {
  id                String   @id @default(uuid()) @db.Uuid
  hubId             String   @map("hub_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  availableQty      Int      @default(0) @map("available_qty")
  reservedQty       Int      @default(0) @map("reserved_qty")
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  minimumStock      Int      @default(0) @map("minimum_stock")
  maximumStock      Int?     @map("maximum_stock")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  hub     Hub     @relation(fields: [hubId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([hubId, productId])
  @@index([productId, availableQty])
  @@index([hubId])
  @@map("hub_inventory")
}

// ─── Cart ────────────────────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid()) @db.Uuid
  cartId       String   @map("cart_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  hubId        String?  @map("hub_id") @db.Uuid
  quantity     Int      @default(1)
  price        Decimal  @db.Decimal(12, 2)
  gst          Decimal  @db.Decimal(5, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  bulkDiscount Decimal  @default(0) @map("bulk_discount") @db.Decimal(12, 2)
  etaMinutes   Int?     @map("eta_minutes")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@index([hubId])
  @@map("cart_items")
}

// ─── Order ───────────────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number") @db.VarChar(30)
  customerId      String        @map("customer_id") @db.Uuid
  addressId       String        @map("address_id") @db.Uuid
  hubId           String?       @map("hub_id") @db.Uuid
  orderStatus     OrderStatus   @default(PENDING) @map("order_status")
  paymentMethod   PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  subtotal        Decimal       @db.Decimal(12, 2)
  gstAmount       Decimal       @default(0) @map("gst_amount") @db.Decimal(12, 2)
  deliveryCharge  Decimal       @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  grandTotal      Decimal       @map("grand_total") @db.Decimal(12, 2)
  isEmergency         Boolean       @default(false) @map("is_emergency")
  loyaltyPointsUsed   Int           @default(0) @map("loyalty_points_used")
  membershipDiscount  Decimal       @default(0) @map("membership_discount") @db.Decimal(12, 2)
  bulkOrder           Boolean       @default(false) @map("bulk_procurement")
  loadingCharges      Decimal       @default(0) @map("loading_charges") @db.Decimal(12, 2)
  unloadingCharges    Decimal       @default(0) @map("unloading_charges") @db.Decimal(12, 2)
  bikeDeliveryFree    Boolean       @default(false) @map("bike_delivery_free")
  priorityOrder       Boolean       @default(false) @map("priority_order")
  assignedDriverId    String?       @map("assigned_driver_id") @db.Uuid
  assignedVehicleId   String?       @map("assigned_vehicle_id") @db.Uuid
  assignedLoaderId    String?       @map("assigned_loader_id") @db.Uuid
  managerId           String?       @map("manager_id") @db.Uuid
  expectedDeliveryAt  DateTime?     @map("expected_delivery_at")
  loadingStartedAt    DateTime?     @map("loading_started_at")
  loadingCompletedAt  DateTime?     @map("loading_completed_at")
  dispatchedAt        DateTime?     @map("dispatched_at")
  driverReachedAt     DateTime?     @map("driver_reached_at")
  deliveryOtp         String?       @map("delivery_otp") @db.VarChar(6)
  deliveryOtpGeneratedAt DateTime?  @map("delivery_otp_generated_at")
  deliveryOtpVerified Boolean       @default(false) @map("delivery_otp_verified")
  deliveryVerifiedBy  String?       @map("delivery_verified_by") @db.VarChar(100)
  deliveryCompletedAt DateTime?     @map("delivery_completed_at")
  paymentCollectedAt  DateTime?     @map("payment_collected_at")
  hubRejectReason     String?       @map("hub_reject_reason") @db.VarChar(500)
  hubRejectedAt       DateTime?     @map("hub_rejected_at")
  deliveryAddress Json?         @map("delivery_address") @db.JsonB
  notes           String?       @db.Text
  cancelReason    String?       @map("cancel_reason") @db.VarChar(500)
  cancelledAt     DateTime?     @map("cancelled_at")
  deliveredAt     DateTime?     @map("delivered_at")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer       Customer        @relation(fields: [customerId], references: [id])
  address        Address         @relation(fields: [addressId], references: [id])
  hub            Hub?            @relation(fields: [hubId], references: [id], onDelete: SetNull)
  manager        HubUser?        @relation("OrderManager", fields: [managerId], references: [id], onDelete: SetNull)
  assignedDriver Driver?         @relation("OrderAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedVehicle Vehicle?       @relation("OrderAssignedVehicle", fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignedLoader HubUser?        @relation("OrderAssignedLoader", fields: [assignedLoaderId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  timeline       OrderTimeline[]
  invoice        Invoice?
  reviews        Review[]
  supportTickets SupportTicket[]
  emergencyOrder EmergencyOrder?
  loadingRecord  HubLoadingRecord?
  unloadingRecord HubUnloadingRecord?
  dispatch       HubDispatch?
  proofOfDelivery ProofOfDelivery?
  refunds         Refund[]

  @@index([customerId, orderStatus, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([hubId, orderStatus])
  @@index([assignedDriverId])
  @@index([assignedVehicleId])
  @@index([assignedLoaderId])
  @@index([addressId])
  @@index([orderNumber])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  name         String   @db.VarChar(300)
  productImage String?  @map("product_image") @db.VarChar(500)
  sku          String?  @db.VarChar(80)
  brand        String?  @db.VarChar(120)
  category     String?  @db.VarChar(120)
  variant      String?  @db.VarChar(120)
  quantity     Int
  unit         String   @db.VarChar(30)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  mrp          Decimal? @db.Decimal(12, 2)
  gst          Decimal  @default(0) @db.Decimal(5, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderTimeline {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  status         OrderStatus
  message        String?     @db.VarChar(500)
  remarks        String?     @db.VarChar(500)
  updatedBy      String      @default("SYSTEM") @map("updated_by") @db.VarChar(100)
  updatedByRole  String?     @map("updated_by_role") @db.VarChar(50)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Asc)])
  @@index([status])
  @@map("order_timelines")
}

model Invoice {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @unique @map("order_id") @db.Uuid
  invoiceNumber    String         @unique @map("invoice_number") @db.VarChar(40)
  status           InvoiceStatus  @default(GENERATED)
  invoiceDate      DateTime       @default(now()) @map("invoice_date")
  subtotal         Decimal        @db.Decimal(12, 2)
