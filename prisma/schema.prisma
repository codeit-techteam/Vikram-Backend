// ─── Customer Auth & Profile ─────────────────────────────────────────────────

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  slug         String   @unique @db.VarChar(50)
  description  String?  @db.VarChar(300)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customers Customer[]

  @@index([isActive, displayOrder])
  @@map("roles")
}

model Customer {
  id               String         @id @default(uuid()) @db.Uuid
  phone            String         @unique @db.VarChar(15)
  email            String?        @unique @db.VarChar(200)
  passwordHash     String?        @map("password_hash") @db.VarChar(255)
  fullName         String?        @map("full_name") @db.VarChar(200)
  roleId           String?        @map("role_id") @db.Uuid
  membershipId     String?        @unique @map("membership_id") @db.Uuid
  loyaltyAccountId String?        @unique @map("loyalty_account_id") @db.Uuid
  isVerified       Boolean        @default(false) @map("is_verified")
  isMember         Boolean        @default(false) @map("is_member")
  status           CustomerStatus @default(ACTIVE)
  roleSelected     Boolean        @default(false) @map("role_selected")
  profileCompleted Boolean        @default(false) @map("profile_completed")
  language         String         @default("en") @db.VarChar(10)
  assignedHubId       String?       @map("assigned_hub_id") @db.Uuid
  assignedExecutiveId String?       @map("assigned_executive_id") @db.Uuid
  registeredByUserId  String?       @map("registered_by_user_id") @db.Uuid
  registrationSource  RegistrationSource? @map("registration_source")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  role               Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  profile            CustomerProfile?
  addresses          Address[]
  refreshTokens      RefreshToken[]
  otpRecords         OtpRecord[]
  deviceSessions     DeviceSession[]
  notificationTokens NotificationToken[]
  wishlist           Wishlist?
  cart               Cart?
  notifications      Notification[]
  scheduledNotifications ScheduledNotification[]
  orders             Order[]
  reviews            Review[]
  supportTickets SupportTicket[]
  supportMessages  SupportMessage[]
  searchHistory      SearchHistory[]
  activeMembership   CustomerMembership? @relation("ActiveMembership", fields: [membershipId], references: [id], onDelete: SetNull)
  loyaltyByPointer   LoyaltyAccount?     @relation("CustomerLoyaltyPointer", fields: [loyaltyAccountId], references: [id], onDelete: SetNull)
  loyaltyAccount     LoyaltyAccount?       @relation("LoyaltyCustomerOwner")
  memberships        CustomerMembership[] @relation("MembershipHistory")
  bulkEnquiries      BulkEnquiry[]
  emergencyOrders    EmergencyOrder[]
  refunds            Refund[]
  paymentLinks       PaymentLink[]
  assignedHub        Hub?                @relation("CustomerAssignedHub", fields: [assignedHubId], references: [id], onDelete: SetNull)
  assignedExecutive  AdminUser?          @relation("CustomerAssignedExecutive", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  registeredBy       AdminUser?          @relation("CustomerRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  executiveAssignmentHistory CustomerExecutiveAssignmentHistory[]
  deliveryBenefit    CustomerDeliveryBenefit?

  @@index([phone])
  @@index([roleId])
  @@index([status])
  @@index([isMember])
  @@index([membershipId])
  @@index([loyaltyAccountId])
  @@index([deletedAt])
  @@index([assignedHubId])
  @@index([assignedExecutiveId])
  @@index([registeredByUserId])
  @@index([registrationSource])
  @@index([createdAt])
  @@map("customers")
}

model CustomerProfile {
  id                 String    @id @default(uuid()) @db.Uuid
