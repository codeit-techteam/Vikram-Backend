}

model ProofOfDelivery {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @unique @map("order_id") @db.Uuid
  deliveryPhotos    Json?    @map("delivery_photos") @db.JsonB
  customerSignature String?  @map("customer_signature") @db.VarChar(500)
  otpVerified       Boolean  @default(false) @map("otp_verified")
  remarks           String?  @db.Text
  deliveredAt       DateTime @map("delivered_at")
  deliveredBy       String?  @map("delivered_by") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("proof_of_deliveries")
}

model HubNotification {
  id        String              @id @default(uuid()) @db.Uuid
  hubId     String              @map("hub_id") @db.Uuid
  hubUserId String?             @map("hub_user_id") @db.Uuid
  type      HubNotificationType @default(SYSTEM)
  title     String              @db.VarChar(300)
  body      String              @db.Text
  actionRoute String?           @map("action_route") @db.VarChar(200)
  isRead    Boolean             @default(false) @map("is_read")
  deletedAt DateTime?           @map("deleted_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  hub Hub @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@index([hubId, isRead, createdAt(sort: Desc)])
  @@index([hubUserId])
  @@index([deletedAt])
  @@map("hub_notifications")
}

model InventoryTransfer {
  id          String                  @id @default(uuid()) @db.Uuid
  fromHubId   String                  @map("from_hub_id") @db.Uuid
  toHubId     String                  @map("to_hub_id") @db.Uuid
  productId   String                  @map("product_id") @db.Uuid
  quantity    Int
  status      InventoryTransferStatus @default(PENDING)
  remarks     String?                 @db.Text
  transferredBy String?               @map("transferred_by") @db.VarChar(100)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  fromHub Hub     @relation("TransferFromHub", fields: [fromHubId], references: [id])
  toHub   Hub     @relation("TransferToHub", fields: [toHubId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([fromHubId, status])
  @@index([toHubId, status])
  @@index([productId])
  @@map("inventory_transfers")
}

// ─── Emergency Orders ────────────────────────────────────────────────────────

model EmergencyOrder {
  id             String                 @id @default(uuid()) @db.Uuid
  customerId     String                 @map("customer_id") @db.Uuid
  orderId        String                 @unique @map("order_id") @db.Uuid
  requiredWithin DateTime               @map("required_within")
  priorityLevel  EmergencyPriorityLevel @default(HIGH) @map("priority_level")
  status         EmergencyOrderStatus   @default(NEW)
  remarks        String?                @db.Text
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([status])
  @@index([customerId, status, createdAt(sort: Desc)])
  @@index([status, priorityLevel])
  @@map("emergency_orders")
}

// ─── Finance Settlements ─────────────────────────────────────────────────────

model SettlementBatch {
  id               String           @id @default(uuid()) @db.Uuid
  settlementNumber String           @unique @map("settlement_number") @db.VarChar(40)
  type             SettlementType
  hubId            String?          @map("hub_id") @db.Uuid
  vendorKey        String?          @map("vendor_key") @db.VarChar(120)
  periodStart      DateTime         @map("period_start")
  periodEnd        DateTime         @map("period_end")
  orderCount       Int              @default(0) @map("order_count")
  grossAmount      Decimal          @map("gross_amount") @db.Decimal(12, 2)
  commissionRate   Decimal          @default(0) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal          @default(0) @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal          @map("net_amount") @db.Decimal(12, 2)
  status           SettlementStatus @default(PENDING)
  orderIds         Json             @default("[]") @map("order_ids") @db.JsonB
  breakdown        Json?            @db.JsonB
  notes            String?          @db.Text
  generatedById    String?          @map("generated_by_id") @db.Uuid
  approvedById     String?          @map("approved_by_id") @db.Uuid
  approvedAt       DateTime?        @map("approved_at")
  rejectedAt       DateTime?        @map("rejected_at")
  rejectReason     String?          @map("reject_reason") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  hub         Hub?       @relation(fields: [hubId], references: [id], onDelete: SetNull)
  generatedBy AdminUser? @relation("SettlementGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  approvedBy  AdminUser? @relation("SettlementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([type, status])
  @@index([hubId, status])
  @@index([vendorKey, status])
  @@index([periodStart, periodEnd])
  @@index([createdAt(sort: Desc)])
  @@map("settlement_batches")
}

// ─── Scheduler / Cron Jobs ───────────────────────────────────────────────────

model DailyBusinessReport {
  id                     String   @id @default(uuid()) @db.Uuid
  date                   DateTime @unique @db.Date
  orders                 Int      @default(0)
  revenue                Decimal  @default(0) @db.Decimal(14, 2)
  cancelledOrders        Int      @default(0) @map("cancelled_orders")
  pendingOrders          Int      @default(0) @map("pending_orders")
  deliveredOrders        Int      @default(0) @map("delivered_orders")
  membershipPurchases    Int      @default(0) @map("membership_purchases")
  membershipSalesAmount  Decimal  @default(0) @map("membership_sales_amount") @db.Decimal(14, 2)
  loyaltyEarned          Int      @default(0) @map("loyalty_earned")
  loyaltyRedeemed        Int      @default(0) @map("loyalty_redeemed")
  newCustomers           Int      @default(0) @map("new_customers")
  bulkProcurementRequests Int     @default(0) @map("bulk_procurement_requests")
  metrics                Json?    @db.JsonB
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@map("daily_business_reports")
}

model ScheduledNotification {
  id            String                        @id @default(uuid()) @db.Uuid
  customerId    String?                       @map("customer_id") @db.Uuid
  channel       ScheduledNotificationChannel  @default(IN_APP)
  type          NotificationType              @default(SYSTEM)
  title         String                        @db.VarChar(300)
  body          String                        @db.Text
  payload       Json?                         @db.JsonB
  scheduledTime DateTime                      @map("scheduled_time")
  status        ScheduledNotificationStatus   @default(PENDING)
  sentAt        DateTime?                     @map("sent_at")
  failureReason String?                       @map("failure_reason") @db.VarChar(500)
  attempts      Int                           @default(0)
  createdAt     DateTime                      @default(now()) @map("created_at")
  updatedAt     DateTime                      @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([status, scheduledTime])
  @@index([customerId, status])
  @@index([scheduledTime])
  @@map("scheduled_notifications")
}

model SchedulerJobLog {
  id             String             @id @default(uuid()) @db.Uuid
  jobName        String             @map("job_name") @db.VarChar(100)
  queueName      String             @map("queue_name") @db.VarChar(100)
  bullJobId      String?            @map("bull_job_id") @db.VarChar(100)
  startedAt      DateTime           @map("started_at")
  finishedAt     DateTime?          @map("finished_at")
  durationMs     Int?               @map("duration_ms")
  processedCount Int                @default(0) @map("processed_count")
  successCount   Int                @default(0) @map("success_count")
  failedCount    Int                @default(0) @map("failed_count")
  status         SchedulerJobStatus @default(RUNNING)
  error          String?            @db.Text
  metadata       Json?              @db.JsonB
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([jobName, startedAt(sort: Desc)])
  @@index([queueName, startedAt(sort: Desc)])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("scheduler_job_logs")
}

// ─── Requisitions ────────────────────────────────────────────────────────────

model Requisition {
  id                   String              @id @default(uuid()) @db.Uuid
  requestNo            String              @unique @map("request_no") @db.VarChar(40)
  hubId                String              @map("hub_id") @db.Uuid
  warehouseId          String?             @map("warehouse_id") @db.VarChar(100)
  warehouseHubId       String?             @map("warehouse_hub_id") @db.Uuid
  priority             RequisitionPriority @default(NORMAL)
  status               RequisitionStatus   @default(DRAFT)
  reason               RequisitionReason
  expectedDate         DateTime            @map("expected_date")
  remarks              String?             @db.Text
  requestedBy          String              @map("requested_by") @db.VarChar(100)
  requestedByName      String?             @map("requested_by_name") @db.VarChar(200)
  approvedBy           String?             @map("approved_by") @db.VarChar(100)
  approvedByName       String?             @map("approved_by_name") @db.VarChar(200)
  allocatedBy          String?             @map("allocated_by") @db.VarChar(100)
  allocatedByName      String?             @map("allocated_by_name") @db.VarChar(200)
  receivedBy           String?             @map("received_by") @db.VarChar(100)
  receivedByName       String?             @map("received_by_name") @db.VarChar(200)
  rejectedBy           String?             @map("rejected_by") @db.VarChar(100)
  rejectedByName       String?             @map("rejected_by_name") @db.VarChar(200)
  rejectionReason      String?             @map("rejection_reason") @db.Text
  submittedAt          DateTime?           @map("submitted_at")
  approvedAt           DateTime?           @map("approved_at")
  allocatedAt          DateTime?           @map("allocated_at")
  dispatchedAt         DateTime?           @map("dispatched_at")
  receivedAt           DateTime?           @map("received_at")
  completedAt          DateTime?           @map("completed_at")
  totalItems           Int                 @default(0) @map("total_items")
  totalQty             Int                 @default(0) @map("total_qty")
  totalValue           Decimal             @default(0) @map("total_value") @db.Decimal(14, 2)
  vehicleId            String?             @map("vehicle_id") @db.Uuid
  driverId             String?             @map("driver_id") @db.Uuid
  vehicleRegistration  String?             @map("vehicle_registration") @db.VarChar(40)
  driverName           String?             @map("driver_name") @db.VarChar(200)
  lrNumber             String?             @map("lr_number") @db.VarChar(80)
  warehouseBin         String?             @map("warehouse_bin") @db.VarChar(80)
  expectedDispatchDate DateTime?           @map("expected_dispatch_date")
  estimatedArrival     DateTime?           @map("estimated_arrival")
  receivingPhotos      Json?               @map("receiving_photos")
  receivingDocuments   Json?               @map("receiving_documents")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  hub          Hub                    @relation("RequisitionHub", fields: [hubId], references: [id])
  warehouseHub Hub?                   @relation("RequisitionWarehouseHub", fields: [warehouseHubId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?               @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver       Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  items        RequisitionItem[]
  timeline     RequisitionTimeline[]
  comments     RequisitionComment[]
  auditLogs    RequisitionAuditLog[]
  ledgerEntries InventoryLedgerEntry[]

  @@index([hubId, status, createdAt(sort: Desc)])
  @@index([warehouseHubId, status])
  @@index([status, priority, createdAt(sort: Desc)])
  @@index([requestNo])
  @@map("requisitions")
}

model RequisitionItem {
  id             String                @id @default(uuid()) @db.Uuid
  requisitionId  String                @map("requisition_id") @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  sku            String?               @db.VarChar(80)
  productName    String                @map("product_name") @db.VarChar(300)
  requestedQty   Int                   @map("requested_qty")
  approvedQty    Int?                  @map("approved_qty")
  allocatedQty   Int?                  @map("allocated_qty")
  receivedQty    Int?                  @map("received_qty")
  availableStock Int                   @default(0) @map("available_stock")
  minimumStock   Int                   @default(0) @map("minimum_stock")
  warehouseStock Int                   @default(0) @map("warehouse_stock")
  unit           String                @db.VarChar(30)
  unitPrice      Decimal               @default(0) @map("unit_price") @db.Decimal(12, 2)
  remarks        String?               @db.Text
  status         RequisitionItemStatus @default(PENDING)
  shortageQty    Int?                  @map("shortage_qty")
  damageQty      Int?                  @map("damage_qty")
  missingQty     Int?                  @map("missing_qty")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([requisitionId])
  @@index([productId])
  @@map("requisition_items")
}

model RequisitionTimeline {
  id            String   @id @default(uuid()) @db.Uuid
  requisitionId String   @map("requisition_id") @db.Uuid
  title         String   @db.VarChar(200)
  subtitle      String?  @db.VarChar(500)
  stepStatus    String   @default("pending") @map("step_status") @db.VarChar(20)
  occurredAt    DateTime? @map("occurred_at")
  createdAt     DateTime @default(now()) @map("created_at")

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId, createdAt])
  @@map("requisition_timeline")
}

model RequisitionComment {
  id            String   @id @default(uuid()) @db.Uuid
  requisitionId String   @map("requisition_id") @db.Uuid
  authorId      String   @map("author_id") @db.VarChar(100)
  authorName    String   @map("author_name") @db.VarChar(200)
  authorRole    String   @map("author_role") @db.VarChar(80)
  message       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId, createdAt(sort: Desc)])
  @@map("requisition_comments")
}

model RequisitionAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  requisitionId String   @map("requisition_id") @db.Uuid
  actorId       String   @map("actor_id") @db.VarChar(100)
  actorName     String   @map("actor_name") @db.VarChar(200)
  actorRole     String   @map("actor_role") @db.VarChar(80)
  action        String   @db.VarChar(80)
  previousValue Json?    @map("previous_value") @db.JsonB
  newValue      Json?    @map("new_value") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId, createdAt(sort: Desc)])
  @@map("requisition_audit_logs")
}

model InventoryLedgerEntry {
  id            String              @id @default(uuid()) @db.Uuid
  hubId         String              @map("hub_id") @db.Uuid
  productId     String              @map("product_id") @db.Uuid
  requisitionId String?             @map("requisition_id") @db.Uuid
  type          InventoryLedgerType
  quantity      Int
  openingQty    Int                 @map("opening_qty")
  closingQty    Int                 @map("closing_qty")
  referenceNo   String?             @map("reference_no") @db.VarChar(80)
  remarks       String?             @db.Text
  createdBy     String?             @map("created_by") @db.VarChar(200)
  createdAt     DateTime            @default(now()) @map("created_at")

  hub         Hub          @relation(fields: [hubId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  requisition Requisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)

  @@index([hubId, productId, createdAt(sort: Desc)])
  @@index([requisitionId])
  @@map("inventory_ledger_entries")
}

model RequisitionNumberCounter {
  id        String   @id @default(uuid()) @db.Uuid
  hubCode   String   @map("hub_code") @db.VarChar(40)
  year      Int
  lastSeq   Int      @default(0) @map("last_seq")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([hubCode, year])
  @@map("requisition_number_counters")
}
