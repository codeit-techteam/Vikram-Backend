{
  "name": "Vikram-Backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "db:repair-migration-checksums": "node --env-file=.env prisma/scripts/repair-migration-checksums.mjs",
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "redis:up": "docker compose -f docker-compose.redis.yml up -d",
    "redis:down": "docker compose -f docker-compose.redis.yml down",
    "redis:logs": "docker compose -f docker-compose.redis.yml logs -f redis",
    "start:debug": "nest start --debug --watch",
    "start:prod": "prisma migrate deploy && npm run db:seed:if-empty && node dist/src/main.js",
    "db:seed:if-empty": "tsx scripts/db-seed-if-empty.ts",
    "db:bootstrap:hub-auth": "tsx scripts/bootstrap-hub-auth.ts",
    "db:audit": "bash scripts/db-audit.sh",
    "db:migrate:local-to-do": "bash scripts/migrate-local-to-do.sh",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:catalog": "tsx prisma/seedCatalog.ts",
    "media:migrate-hero-video": "tsx --env-file=.env prisma/scripts/migrate-hero-video-to-r2.ts",
    "media:migrate-catalog-images": "tsx --env-file=.env prisma/scripts/migrate-catalog-images-to-r2.ts",
    "media:upload-rmc-category": "tsx --env-file=.env prisma/scripts/upload-rmc-category-image.ts",
    "media:upload-brick-images": "tsx --env-file=.env prisma/scripts/upload-brick-images-to-r2.ts",
    "media:upload-delivery-vehicles": "tsx --env-file=.env prisma/scripts/upload-delivery-vehicle-images.ts",
    "media:migrate-testimonials": "tsx --env-file=.env prisma/scripts/migrate-testimonials-to-r2.ts",
    "media:repair-cms": "tsx --env-file=.env prisma/scripts/repair-cms-media-urls.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/lib-storage": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "^7.9.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cron": "^4.4.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "morgan": "^1.11.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typescript": "^5.7.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
