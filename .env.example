# =============================================================================
# Bajriwala ERP Marketplace — Environment Variables Template
# =============================================================================
# Copy this file to .env.development for local development:
#   cp .env.example .env.development
#
# Never commit real secrets. Use your secrets manager in production.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Bajriwala ERP API
PORT=8000
API_PREFIX=api

# Comma-separated allowed origins (Customer App, Admin Panel, Hub Panel).
# Include every browser origin that calls the API directly (e.g. local Hub on :3000).
# CORS_ORIGINS=http://localhost:3000,https://YOUR-PRODUCTION-FRONTEND-DOMAIN
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# -----------------------------------------------------------------------------
# PostgreSQL (Application)
# -----------------------------------------------------------------------------
# Used by NestJS (PrismaService) and Prisma CLI (migrations).
# Local:
DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/YOUR_POSTGRES_DB?schema=public
#
# Production (DigitalOcean App Platform + Managed PostgreSQL db-pgsql-blr1-63888):
# Prefer private VPC URL when the DB is attached to the same app:
#   DATABASE_URL=${db-pgsql-blr1-63888.DATABASE_PRIVATE_URL}
# Public hostname fallback (requires Trusted Sources for App Platform / egress IPs):
#   DATABASE_URL=${db-pgsql-blr1-63888.DATABASE_URL}
# App also accepts DATABASE_PRIVATE_URL if DATABASE_URL is unset.
# Keep sslmode=require. Do NOT disable SSL.
# Recommended CA (prefer over rejectUnauthorized:false):
#   DATABASE_CA_CERT=${db-pgsql-blr1-63888.CA_CERT}
# Build: npm ci && npm run build
# Run:  npm run start:prod
# Trusted Sources must allow the vikram-backend component (or dedicated egress IPs).

# Connection pool settings (keep well below the managed DB connection limit)
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose — docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_POSTGRES_DB
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (Application)
# -----------------------------------------------------------------------------
# Local:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Production (DigitalOcean Managed Redis / Valkey): prefer the connection string.
# REDIS_URL=rediss://default:PASSWORD@your-redis-host:25061
# REDIS_TLS=true
# REDIS_USERNAME=default

# -----------------------------------------------------------------------------
# Authentication (JWT) — configure when auth module is built
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d

# Dev-only fixed OTP for local testing (ignored in production)
OTP_DEV_BYPASS_CODE=123456
# Only this phone receives the fixed bypass OTP in non-production. Others get a random OTP.
OTP_DEV_PHONE=8240890242

# Optional external OTP / SMS / WhatsApp providers (reuse when wired)
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=
OTP_TEMPLATE_ID=
SMS_PROVIDER=
WHATSAPP_PROVIDER=

# Payment link / gateway abstraction (MVP uses in-app notification + PaymentLink records)
PAYMENT_PROVIDER=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000
CUSTOMER_APP_URL=http://localhost:8081
PAYMENT_LINK_BASE_URL=

# Internal service-to-service API key (wallet spend/refund during checkout)
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY

# -----------------------------------------------------------------------------
# Company / GST Invoice
# -----------------------------------------------------------------------------
COMPANY_NAME=Bajriwala
COMPANY_GSTIN=27AAAAA0000A1Z5
COMPANY_ADDRESS_LINE1=123 Industrial Area
COMPANY_ADDRESS_LINE2=Near Central Warehouse
COMPANY_CITY=Mumbai
COMPANY_STATE=Maharashtra
COMPANY_PINCODE=400001
COMPANY_PHONE=+91-9876543210
COMPANY_EMAIL=billing@bajriwala.com
COMPANY_WEBSITE=https://bajriwala.com
INVOICE_UPLOADS_DIR=uploads/invoices
LOYALTY_MIN_REDEEM_ORDER_VALUE=500
LOYALTY_POINT_VALUE_INR=0.01
LOYALTY_MAX_ORDER_REDEEM_PERCENT=0.3
LOYALTY_EARN_POINTS_PER_100_INR=1
LOYALTY_POINTS_EXPIRY_MONTHS=12
LOYALTY_WELCOME_BONUS=50
LOYALTY_FIRST_ORDER_BONUS=50
FREE_BIKE_DELIVERIES=3
# Company absorption when free bike benefit is used (separate from Bike list price ₹100)
BIKE_DELIVERY_COMPANY_COST=99
# Note: After migration 20260811195000_delivery_pricing_rules, DeliveryBenefitConfig
# and DeliveryPricingRule in the database are the source of truth.
# DELIVERY_CHARGE env is deprecated — do not use for customer checkout.
INVOICE_TERMS=1. Goods once sold will not be taken back.\n2. Subject to local jurisdiction.\n3. E.& O.E.
INVOICE_EMAIL_ENABLED=false

# -----------------------------------------------------------------------------
# Email (SMTP) — mock by default; set EMAIL_ENABLED=true for production
# -----------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM=noreply@bajriwala.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Cloudflare R2 (Object Storage)
# -----------------------------------------------------------------------------
MEDIA_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bajriwala
R2_ENDPOINT=
# Public CDN / r2.dev base URL (no trailing slash). Required for permanent playback without signed URLs.
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Firebase Admin (Push Notifications) — configure when notifications are built
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Scheduler / Cron Jobs (BullMQ workers)
# -----------------------------------------------------------------------------
# Set SCHEDULER_ENABLED=false temporarily if Managed Redis hits
# "ERR max requests limit exceeded" — stops BullMQ workers + Nest crons.
SCHEDULER_ENABLED=true
# Standard 6-field cron: second minute hour day-of-month month day-of-week
MEMBERSHIP_CRON=0 30 0 * * *
LOYALTY_CRON=0 0 1 * * *
REPORT_CRON=0 50 23 * * *
NOTIFICATION_CRON=0 */30 * * * *
SCHEDULER_JOB_ATTEMPTS=3
SCHEDULER_JOB_BACKOFF_MS=5000
SCHEDULER_PROCESSOR_CONCURRENCY=1
# Empty-queue poll interval (ms). BullMQ default is 5ms and burns Redis quotas.
SCHEDULER_DRAIN_DELAY_MS=5000
SCHEDULER_STALLED_INTERVAL_MS=120000
SCHEDULER_LOCK_DURATION_MS=60000
