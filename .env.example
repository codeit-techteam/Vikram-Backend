# =============================================================================
# Bajriwala ERP Marketplace — Environment Variables Template
# =============================================================================
# Copy this file to .env.development for local development:
#   cp .env.example .env.development
#
# Never commit real secrets. Use your secrets manager in production.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Bajriwala ERP API
PORT=3000
API_PREFIX=api

# Comma-separated allowed origins (Customer App, Admin Panel, Hub Panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# -----------------------------------------------------------------------------
# PostgreSQL (Application)
# -----------------------------------------------------------------------------
# Used by NestJS (PrismaService) and Prisma CLI (migrations)
DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/YOUR_POSTGRES_DB?schema=public

# Connection pool settings
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose — docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_POSTGRES_DB
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (Application)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Authentication (JWT) — configure when auth module is built
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d

# Dev-only fixed OTP for local testing (ignored in production)
OTP_DEV_BYPASS_CODE=123456

# -----------------------------------------------------------------------------
# Cloudflare R2 (Object Storage) — configure when file uploads are built
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Firebase Admin (Push Notifications) — configure when notifications are built
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
