# =============================================================================
# Bajriwala ERP Marketplace — Environment Variables Template
# =============================================================================
# Copy this file to .env.development for local development:
#   cp .env.example .env.development
#
# Never commit real secrets. Use your secrets manager in production.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Bajriwala ERP API
PORT=8000
API_PREFIX=api

# Comma-separated allowed origins (Customer App, Admin Panel, Hub Panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# -----------------------------------------------------------------------------
# PostgreSQL (Application)
# -----------------------------------------------------------------------------
# Used by NestJS (PrismaService) and Prisma CLI (migrations)
DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/YOUR_POSTGRES_DB?schema=public

# Connection pool settings
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose — docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_DB=YOUR_POSTGRES_DB
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis (Application)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Authentication (JWT) — configure when auth module is built
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=30d

# Dev-only fixed OTP for local testing (ignored in production)
OTP_DEV_BYPASS_CODE=123456

# Internal service-to-service API key (wallet spend/refund during checkout)
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_SERVICE_KEY

# -----------------------------------------------------------------------------
# Company / GST Invoice
# -----------------------------------------------------------------------------
COMPANY_NAME=Bajriwala
COMPANY_GSTIN=27AAAAA0000A1Z5
COMPANY_ADDRESS_LINE1=123 Industrial Area
COMPANY_ADDRESS_LINE2=Near Central Warehouse
COMPANY_CITY=Mumbai
COMPANY_STATE=Maharashtra
COMPANY_PINCODE=400001
COMPANY_PHONE=+91-9876543210
COMPANY_EMAIL=billing@bajriwala.com
COMPANY_WEBSITE=https://bajriwala.com
INVOICE_UPLOADS_DIR=uploads/invoices
LOYALTY_MIN_REDEEM_POINTS=500
LOYALTY_POINT_VALUE_INR=1
LOYALTY_MAX_ORDER_REDEEM_PERCENT=0.3
LOYALTY_EARN_POINTS_PER_100_INR=1
LOYALTY_POINTS_EXPIRY_MONTHS=12
INVOICE_TERMS=1. Goods once sold will not be taken back.\n2. Subject to local jurisdiction.\n3. E.& O.E.
INVOICE_EMAIL_ENABLED=false

# -----------------------------------------------------------------------------
# Email (SMTP) — mock by default; set EMAIL_ENABLED=true for production
# -----------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM=noreply@bajriwala.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Cloudflare R2 (Object Storage) — configure when file uploads are built
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Firebase Admin (Push Notifications) — configure when notifications are built
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Scheduler / Cron Jobs (BullMQ workers)
# -----------------------------------------------------------------------------
# Standard 6-field cron: second minute hour day-of-month month day-of-week
MEMBERSHIP_CRON=0 30 0 * * *
LOYALTY_CRON=0 0 1 * * *
REPORT_CRON=0 50 23 * * *
NOTIFICATION_CRON=*/10 * * * *
SCHEDULER_JOB_ATTEMPTS=3
SCHEDULER_JOB_BACKOFF_MS=5000
SCHEDULER_PROCESSOR_CONCURRENCY=2
