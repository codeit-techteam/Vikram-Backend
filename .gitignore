# Dependencies
node_modules/

# Build output
dist/
# Jest coverage reports (root only — do not ignore src/modules/coverage)
/coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment — never commit secrets
.env
.env.*
!.env.example

# Database migration backups (may contain production data)
backups/

# Prisma generated client
generated/

# Local uploads (keep folder via .gitkeep)
uploads/*
!uploads/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
